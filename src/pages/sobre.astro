---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';
import { DEFAULT_WHATSAPP_MESSAGE } from '../lib/whatsapp';
import sobreVidracariaFachada from '../assets/images/sobre-vidracaria-fachada-botucatu-sp.jpg';

const title = `Sobre a ${SITE.shortName} | Vidraçaria em Botucatu SP`;
const description = `Conheça a história da ${SITE.shortName}, vidraçaria em Botucatu SP com ${SITE.experienceYears} anos de experiência em vidro temperado.`;

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Sobre', path: '/sobre/' },
];

const experienceYears = SITE.experienceYears;
---

<Layout title={title} description={description} whatsappMessage={DEFAULT_WHATSAPP_MESSAGE} jsonLd={[breadcrumbSchema(crumbs)]}>
  <Breadcrumbs items={crumbs} />

  <section class="container-page grid gap-10 pb-16 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="eyebrow">Sobre nós</p>
      <h1 class="mt-2 text-4xl font-bold text-ink-900">
        Tradição em vidro, atendimento próximo de quem mora em Botucatu
      </h1>
      <p class="mt-4 text-ink-700">
        Vidraceiro com {experienceYears} anos de experiência, a {SITE.shortName} fabrica e instala vidro
        temperado para residências e comércios em Botucatu e região. Atendemos desde
        projetos simples, como a troca de um <a href="/box-de-banheiro/" class="font-semibold text-brand-600 hover:underline">box de banheiro</a>,
        até projetos complexos, como <a href="/fachadas-comerciais/" class="font-semibold text-brand-600 hover:underline">fachadas comerciais</a> completas.
      </p>
      <p class="mt-4 text-ink-700">
        Nosso diferencial é acompanhar o cliente do início ao fim: medição no local, orientação sobre o
        tipo de <a href="/vidro-temperado/" class="font-semibold text-brand-600 hover:underline">vidro temperado</a> mais adequado, fabricação sob medida e instalação feita
        pelo próprio vidraceiro, sem terceirizar a etapa mais importante do serviço.
      </p>
      <p class="mt-4 text-ink-700">
        Confira a lista completa dos nossos <a href="/servicos/" class="font-semibold text-brand-600 hover:underline">serviços de vidraçaria em Botucatu</a> e encontre a solução ideal para o seu projeto.
      </p>
    </div>
    <div class="overflow-hidden rounded-2xl">
      <Image
        src={sobreVidracariaFachada}
        alt="Varanda residencial ampla com portas de vidro de correr e vista para o jardim"
        width={1200}
        height={900}
        loading="eager"
        class="h-full w-full object-cover"
      />
    </div>
  </section>

  <section class="section bg-slate-50">
    <div class="container-page grid gap-8 sm:grid-cols-3">
      <div class="rounded-2xl bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-ink-900">Missão</h2>
        <p class="mt-2 text-sm text-ink-700">
          Entregar soluções em vidro com segurança, precisão de medidas e prazo combinado, para casas e
          comércios de Botucatu e região.
        </p>
      </div>
      <div class="rounded-2xl bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-ink-900">Como trabalhamos</h2>
        <p class="mt-2 text-sm text-ink-700">
          Visita técnica, orçamento detalhado, fabricação sob medida e instalação pelo próprio vidraceiro,
          com garantia por escrito em cada etapa.
        </p>
      </div>
      <div class="rounded-2xl bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-ink-900">Onde atuamos</h2>
        <p class="mt-2 text-sm text-ink-700">
          Botucatu e cidades vizinhas: {SITE.areaServed.slice(0, 4).join(', ')} e outras localidades da
          região.
        </p>
      </div>
    </div>
  </section>

  <CtaSection whatsappMessage={DEFAULT_WHATSAPP_MESSAGE} />
</Layout>
