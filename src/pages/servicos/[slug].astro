---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaSection from '../../components/CtaSection.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { SITE } from '../../data/site';
import { SERVICES } from '../../data/services';
import { breadcrumbSchema, serviceSchema, faqSchema } from '../../lib/schema';
import { waLink, serviceWhatsappMessage } from '../../lib/whatsapp';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos' },
  { name: service.shortTitle, path: `/servicos/${service.slug}` },
];

const otherServices = SERVICES.filter((s) => s.slug !== service.slug).slice(0, 3);
const ogImageResult = await getImage({ src: service.heroImage, width: 1200, height: 630, fit: 'cover' });
const ogImage = new URL(ogImageResult.src, SITE.url).toString();
const whatsappMessage = serviceWhatsappMessage(service.shortTitle);
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  image={ogImage}
  whatsappMessage={whatsappMessage}
  jsonLd={[breadcrumbSchema(crumbs), serviceSchema(service), faqSchema(service.faqs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="container-page grid gap-10 pb-10 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="eyebrow">{SITE.shortName}</p>
      <h1 class="mt-2 text-4xl font-bold text-ink-900">{service.title}</h1>
      <p class="mt-4 text-lg text-ink-700">{service.summary}</p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href={waLink(whatsappMessage)} target="_blank" rel="noopener" class="btn-whatsapp">
          Solicitar orçamento
        </a>
        <a href="/servicos" class="btn-secondary">Ver outros serviços</a>
      </div>
    </div>
    <div class="overflow-hidden rounded-2xl">
      <Image
        src={service.heroImage}
        alt={service.heroImageAlt}
        width={1200}
        height={900}
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </div>
  </section>

  <section class="container-page pb-14">
    <div class="prose-content max-w-3xl space-y-4 text-ink-700">
      {service.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section bg-slate-50">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold text-ink-900">Benefícios</h2>
        <ul class="mt-5 space-y-3">
          {service.benefits.map((benefit) => (
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-brand-600"></span>
              <span class="text-ink-700">{benefit}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-ink-900">Como funciona</h2>
        <ol class="mt-5 space-y-5">
          {service.process.map((step, index) => (
            <li class="flex gap-4">
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
                {index + 1}
              </span>
              <div>
                <p class="font-semibold text-ink-900">{step.title}</p>
                <p class="text-sm text-ink-700">{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl font-bold text-ink-900">Perguntas frequentes</h2>
      <div class="mt-6">
        <FaqAccordion faqs={service.faqs} />
      </div>
    </div>
  </section>

  <section class="section bg-slate-50">
    <div class="container-page">
      <h2 class="text-2xl font-bold text-ink-900">Outros serviços</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {otherServices.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CtaSection whatsappMessage={whatsappMessage} />
</Layout>
