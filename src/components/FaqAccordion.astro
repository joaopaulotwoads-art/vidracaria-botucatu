---
import type { Faq } from '../data/services';

interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;
---

<div class="divide-y divide-ink-900/10 rounded-2xl border border-ink-900/10 bg-white">
  {faqs.map((faq) => (
    <details class="group p-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink-900">
        {faq.question}
        <svg aria-hidden="true" class="h-5 w-5 flex-shrink-0 transition group-open:rotate-45" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </summary>
      <p class="mt-3 text-sm leading-relaxed text-ink-700">{faq.answer}</p>
    </details>
  ))}
</div>
