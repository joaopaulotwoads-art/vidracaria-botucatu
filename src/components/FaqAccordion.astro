---
import type { Faq } from '../data/services';

interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;
---

<div class="space-y-3">
  {faqs.map((faq) => (
    <details class="group rounded-[14px] border border-line bg-white">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-ink-900 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-700 sm:px-6">
        {faq.question}
        <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600 transition-transform duration-200 group-open:rotate-45">
          <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </span>
      </summary>
      <p class="px-5 pb-5 text-sm leading-relaxed text-ink-700 sm:px-6">{faq.answer}</p>
    </details>
  ))}
</div>
