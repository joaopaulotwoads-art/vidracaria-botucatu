---
interface Item {
  name: string;
  path: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="container-page py-4 text-sm text-ink-500">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((item, index) => (
      <li class="flex items-center gap-1">
        {index > 0 && <span aria-hidden="true" class="mx-1">/</span>}
        {index === items.length - 1 ? (
          <span aria-current="page" class="font-medium text-ink-900">{item.name}</span>
        ) : (
          <a href={item.path} class="hover:text-brand-600">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
