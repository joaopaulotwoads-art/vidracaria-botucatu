---
import { SITE, NAV_LINKS } from '../data/site';
import { waLink, DEFAULT_WHATSAPP_MESSAGE } from '../lib/whatsapp';

interface Props {
  whatsappMessage?: string;
}
const { whatsappMessage = DEFAULT_WHATSAPP_MESSAGE } = Astro.props;

const currentPath = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-ink-900/5 bg-white/95 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-lg font-bold text-ink-900">
      <svg aria-hidden="true" class="h-7 w-7 text-brand-600" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.6" />
        <path d="M3 9h18M9 21V9" stroke="currentColor" stroke-width="1.6" />
      </svg>
      <span>{SITE.shortName}</span>
    </a>

    <nav aria-label="Navegação principal" class="hidden items-center gap-8 md:flex">
      {NAV_LINKS.map((link) => {
        const linkPath = link.href.replace(/\/$/, '') || '/';
        const isActive = currentPath === linkPath;
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'text-sm font-medium transition-colors hover:text-brand-600',
              isActive ? 'text-brand-600' : 'text-ink-700',
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden md:block">
      <a href={waLink(whatsappMessage)} class="btn-whatsapp" target="_blank" rel="noopener">
        Peça seu orçamento
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-md text-ink-900 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menu"
    >
      <svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Navegação móvel" class="hidden border-t border-ink-900/5 bg-white md:hidden">
    <div class="container-page flex flex-col gap-1 py-3">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class="flex items-center rounded-md px-2 py-3 text-sm font-medium text-ink-700 hover:bg-slate-50">
          {link.label}
        </a>
      ))}
      <a href={waLink(whatsappMessage)} class="btn-whatsapp mt-2" target="_blank" rel="noopener">
        Peça seu orçamento
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
  });
</script>
