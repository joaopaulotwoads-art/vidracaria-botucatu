---
import { waLink, DEFAULT_WHATSAPP_MESSAGE } from '../lib/whatsapp';

interface Props {
  whatsappMessage?: string;
}
const { whatsappMessage = DEFAULT_WHATSAPP_MESSAGE } = Astro.props;
---

<a
  href={waLink(whatsappMessage)}
  target="_blank"
  rel="noopener"
  aria-label="Falar no WhatsApp"
  class="fixed right-4 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-ink-900 shadow-lg transition hover:bg-whatsapp-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700"
  style="bottom: max(1rem, env(safe-area-inset-bottom)); right: max(1rem, env(safe-area-inset-right));"
>
  <span class="whatsapp-pulse absolute inset-0 rounded-full bg-whatsapp" aria-hidden="true"></span>
  <svg aria-hidden="true" class="relative h-7 w-7" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 2.2c-5.4 0-9.8 4.4-9.8 9.8 0 1.73.45 3.4 1.3 4.88L2.1 21.8l5.06-1.33a9.75 9.75 0 0 0 4.84 1.29h.01c5.4 0 9.8-4.4 9.8-9.8s-4.4-9.76-9.81-9.76Zm0 17.9h-.01a8.1 8.1 0 0 1-4.14-1.13l-.3-.18-3 .79.8-2.93-.2-.3a8.14 8.14 0 0 1-1.25-4.35c0-4.5 3.66-8.16 8.16-8.16 4.5 0 8.15 3.66 8.15 8.16 0 4.5-3.65 8.1-8.21 8.1Zm4.47-6.1c-.24-.12-1.45-.72-1.68-.8-.22-.08-.39-.12-.55.12-.17.25-.63.8-.78.96-.14.17-.28.19-.53.06-.24-.12-1.03-.38-1.96-1.21-.72-.65-1.21-1.44-1.35-1.69-.14-.24-.02-.37.11-.5.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.17.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.05 0 1.2.88 2.37 1 2.53.12.17 1.73 2.64 4.19 3.7.59.25 1.04.4 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.45-.59 1.65-1.17.2-.57.2-1.06.14-1.17-.06-.11-.22-.17-.46-.29Z"/>
  </svg>
</a>

<style>
  .whatsapp-pulse {
    animation: wa-pulse 2.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes wa-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }
</style>
