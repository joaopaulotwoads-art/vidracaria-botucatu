---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import FaqAccordion from './FaqAccordion.astro';
import CtaSection from './CtaSection.astro';
import ServiceCard from './ServiceCard.astro';
import { SITE } from '../data/site';
import { SERVICES, servicePath, type Service } from '../data/services';
import { breadcrumbSchema, serviceSchema, faqSchema } from '../lib/schema';
import { waLink, serviceWhatsappMessage } from '../lib/whatsapp';

interface Props {
  service: Service;
}

const { service } = Astro.props;

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos/' },
  { name: service.shortTitle, path: servicePath(service) },
];

const otherServices = SERVICES.filter((s) => s.slug !== service.slug).slice(0, 3);
const ogImageResult = await getImage({ src: service.heroImage, width: 1200, height: 630, fit: 'cover' });
const ogImage = new URL(ogImageResult.src, SITE.url).toString();
const whatsappMessage = serviceWhatsappMessage(service.shortTitle);

const checkIcon = 'M4 10.5 8 14l8-8';
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  image={ogImage}
  whatsappMessage={whatsappMessage}
  jsonLd={[breadcrumbSchema(crumbs), serviceSchema(service), faqSchema(service.faqs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="container-page grid gap-10 pb-10 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="eyebrow">{SITE.shortName}</p>
      <h1 class="mt-2 text-4xl font-bold text-ink-900">{service.title}</h1>
      <p class="mt-4 text-lg text-ink-700">{service.summary}</p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href={waLink(whatsappMessage)} target="_blank" rel="noopener" class="btn-whatsapp">
          Solicitar orçamento
        </a>
        <a href="/servicos/" class="btn-secondary">Ver outros serviços</a>
      </div>
    </div>
    <div class="glass-panel relative">
      <Image
        src={service.heroImage}
        alt={service.heroImageAlt}
        width={1200}
        height={900}
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/3] h-full w-full object-cover"
      />
      <div class="glass-sheen"></div>
    </div>
  </section>

  <section class="container-page pb-14">
    <h2 class="text-2xl text-ink-900">{service.shortTitle} em Botucatu perto de você</h2>
    <div class="prose-content mt-4 max-w-3xl space-y-4 text-ink-700">
      {service.intro.map((paragraph) => <p set:html={paragraph} />)}
    </div>
  </section>

  <section class="section border-y border-ink-900/8 bg-slate-50/60">
    <div class="container-page grid gap-6 lg:grid-cols-2">
      <div class="glass-panel p-6 sm:p-8">
        <h2 class="text-xl text-ink-900">Tipos de vidro e espessuras</h2>
        <ul class="mt-5 space-y-3">
          {service.typesAndThickness.map((item) => (
            <li class="flex gap-3">
              <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-brand-50">
                <svg aria-hidden="true" class="h-3 w-3 text-brand-600" viewBox="0 0 20 20" fill="none"><path d={checkIcon} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="text-ink-700">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="glass-panel p-6 sm:p-8">
        <h2 class="text-xl text-ink-900">Faixa de preço e o que influencia o valor</h2>
        <p class="mt-3 text-sm text-ink-700">
          Não trabalhamos com tabela fechada, porque o valor muda bastante conforme o projeto. O orçamento é
          sempre feito depois da visita técnica, sem compromisso. O que mais influencia o preço:
        </p>
        <ul class="mt-4 space-y-3">
          {service.priceFactors.map((factor) => (
            <li class="flex gap-3">
              <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-brand-50">
                <svg aria-hidden="true" class="h-3 w-3 text-brand-600" viewBox="0 0 20 20" fill="none"><path d={checkIcon} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="text-ink-700">{factor}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl text-ink-900">Por que escolher nossa vidraçaria</h2>
        <ul class="mt-5 space-y-3">
          {service.benefits.map((benefit) => (
            <li class="flex gap-3">
              <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-brand-50">
                <svg aria-hidden="true" class="h-3 w-3 text-brand-600" viewBox="0 0 20 20" fill="none"><path d={checkIcon} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="text-ink-700">{benefit}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl text-ink-900">Como funciona</h2>
        <ol class="mt-5 space-y-5">
          {service.process.map((step, index) => (
            <li class="flex gap-4">
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border border-brand-600/20 bg-brand-50 text-sm font-semibold text-brand-700">
                {index + 1}
              </span>
              <div>
                <p class="font-semibold text-ink-900">{step.title}</p>
                <p class="text-sm text-ink-700">{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/60">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl text-ink-900">Erros comuns ao contratar {service.shortTitle.toLowerCase()}</h2>
      <ul class="mt-5 space-y-3">
        {service.commonMistakes.map((mistake) => (
          <li class="flex gap-3">
            <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-ink-900/5">
              <svg aria-hidden="true" class="h-3 w-3 text-ink-500" viewBox="0 0 20 20" fill="none"><path d="M6 6l8 8M14 6l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </span>
            <span class="text-ink-700">{mistake}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-page py-10">
    <div class="glass-panel flex flex-col items-center gap-3 px-6 py-8 text-center sm:py-10">
      <p class="text-sm text-ink-700">
        Ficou com alguma dúvida sobre {service.shortTitle.toLowerCase()}?
      </p>
      <a href={waLink(whatsappMessage)} target="_blank" rel="noopener" class="btn-whatsapp">
        Solicitar orçamento
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl text-ink-900">Cuidados e manutenção</h2>
      <ul class="mt-5 space-y-3">
        {service.careTips.map((tip) => (
          <li class="flex gap-3">
            <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-brand-50">
              <svg aria-hidden="true" class="h-3 w-3 text-brand-600" viewBox="0 0 20 20" fill="none"><path d={checkIcon} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="text-ink-700">{tip}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-slate-50/60">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl text-ink-900">Perguntas frequentes</h2>
      <div class="mt-6">
        <FaqAccordion faqs={service.faqs} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl text-ink-900">Bairros e cidades atendidos</h2>
      <p class="mt-3 text-ink-700">
        Atendemos {service.shortTitle.toLowerCase()} em todos os bairros de Botucatu e nas cidades da região:{' '}
        {SITE.areaServed.map((city, index) => (
          <>
            {city}{index < SITE.areaServed.length - 1 ? ', ' : '.'}
          </>
        ))}
      </p>
      <a href="/onde-atendemos/" class="mt-4 inline-block font-semibold text-brand-600 hover:underline">
        Ver bairros e cidades atendidos em detalhe →
      </a>
    </div>
  </section>

  <section class="section bg-slate-50/60">
    <div class="container-page">
      <h2 class="text-2xl text-ink-900">Outros serviços</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {otherServices.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CtaSection whatsappMessage={whatsappMessage} />
</Layout>
