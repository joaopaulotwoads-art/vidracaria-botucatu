---
import { SITE, NAV_LINKS } from '../data/site';
import { SERVICES, servicePath } from '../data/services';

const year = new Date().getFullYear();
---

<footer class="bg-ink-900 text-slate-300">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-lg font-bold text-white">{SITE.shortName}</p>
      <p class="mt-3 text-sm leading-relaxed text-slate-400">{SITE.description}</p>
      <div class="-ml-2 mt-4 flex gap-2">
        <a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram da Vidraçaria Botucatu" class="flex h-11 w-11 items-center justify-center text-slate-400 hover:text-white">
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 2 .25 2.5.46.5.2 1 .5 1.4 1 .4.4.7.9 1 1.4.2.5.4 1.3.46 2.5.06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.06 1.2-.25 2-.46 2.5-.2.5-.5 1-1 1.4-.4.4-.9.7-1.4 1-.5.2-1.3.4-2.5.46-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-2-.25-2.5-.46a4 4 0 0 1-1.4-1 4 4 0 0 1-1-1.4c-.2-.5-.4-1.3-.46-2.5C2.21 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.25-2 .46-2.5.2-.5.5-1 1-1.4.4-.4.9-.7 1.4-1 .5-.2 1.3-.4 2.5-.46C8.4 2.21 8.8 2.2 12 2.2Zm0 1.8c-3.14 0-3.52 0-4.76.07-1 .05-1.55.22-1.9.36-.48.19-.82.42-1.18.78-.36.36-.59.7-.78 1.18-.14.36-.3.9-.36 1.9C3 9.48 3 9.86 3 13s0 3.52.07 4.76c.05 1 .22 1.55.36 1.9.19.48.42.82.78 1.18.36.36.7.59 1.18.78.36.14.9.3 1.9.36 1.24.06 1.62.07 4.76.07s3.52 0 4.76-.07c1-.05 1.55-.22 1.9-.36.48-.19.82-.42 1.18-.78.36-.36.59-.7.78-1.18.14-.36.3-.9.36-1.9.06-1.24.07-1.62.07-4.76s0-3.52-.07-4.76c-.05-1-.22-1.55-.36-1.9a3.17 3.17 0 0 0-.78-1.18 3.17 3.17 0 0 0-1.18-.78c-.36-.14-.9-.3-1.9-.36C15.52 4 15.14 4 12 4Zm0 3.4a5.6 5.6 0 1 1 0 11.2 5.6 5.6 0 0 1 0-11.2Zm0 1.8a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm5.9-3.1a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6Z"/></svg>
        </a>
        <a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook da Vidraçaria Botucatu" class="flex h-11 w-11 items-center justify-center text-slate-400 hover:text-white">
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.2h2.4l.4-2.8h-2.8V9.1c0-.8.3-1.4 1.5-1.4h1.4V5.2c-.3 0-1.3-.1-2.4-.1-2.4 0-4.1 1.5-4.1 4.2v2.5H7.5v2.8H10V21h3.5Z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <p class="font-semibold text-white">Navegação</p>
      <ul class="mt-3 space-y-2 text-sm">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href} class="hover:text-white">{link.label}</a></li>
        ))}
        <li><a href="/onde-atendemos/" class="hover:text-white">Onde atendemos</a></li>
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white">Serviços</p>
      <ul class="mt-3 space-y-2 text-sm">
        {SERVICES.map((service) => (
          <li><a href={servicePath(service)} class="hover:text-white">{service.shortTitle}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white">Contato</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>Atendemos em {SITE.address.city} {SITE.address.state} e região</li>
        <li><a href={`tel:${SITE.phoneE164}`} class="hover:text-white">{SITE.phoneDisplay}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-5 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {SITE.legalName}. Todos os direitos reservados.</p>
      <p>Atendimento em {SITE.address.city} {SITE.address.state} e região.</p>
    </div>
  </div>
</footer>
